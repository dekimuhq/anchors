{
  "name": "@dekimuhq/adr-profiles",
  "version": "0.4.2",
  "description": "Regulation profile validators for ADR v1: aiact.art26.deployer, aiact.art14.oversight, agentops.scoped-delegation, gdpr.art28.processor, corporate.officer.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekimuhq/anchors.git",
    "directory": "adr/adr-profiles"
  },
  "homepage": "https://github.com/dekimuhq/anchors/tree/main/adr/adr-profiles#readme",
  "bugs": "https://github.com/dekimuhq/anchors/issues",
  "keywords": [
    "adr",
    "anchored-delegation-receipts",
    "profiles",
    "ai-act",
    "gdpr",
    "delegation"
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-anchor-pkg.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@dekimuhq/anchors-envelope": "^0.26.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
