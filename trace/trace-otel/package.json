{
  "name": "@dekimuhq/trace-otel",
  "version": "0.1.1",
  "description": "Convert OpenTelemetry spans to signed ar.trace.v2 (AgTR) receipts. OTel is an optional peer dependency; the core anchors verifier stays OTel-free.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekimuhq/anchors.git",
    "directory": "trace/trace-otel"
  },
  "homepage": "https://github.com/dekimuhq/anchors/tree/main/trace/trace-otel#readme",
  "bugs": "https://github.com/dekimuhq/anchors/issues",
  "keywords": [
    "agtr",
    "anchored-agent-trace-receipts",
    "opentelemetry",
    "otel",
    "span-exporter",
    "trace"
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-anchor-pkg.mjs",
    "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@dekimuhq/trace": "^0.2.2"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "@opentelemetry/sdk-trace-base": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
