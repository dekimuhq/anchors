{
  "name": "@dekimuhq/trace",
  "version": "0.2.2",
  "description": "Anchored Agent-Trace Receipts (AgTR) v1 — verify (default) + issue (./issue). Execution provenance, not verified behavior.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./issue": {
      "types": "./dist/issue/index.d.ts",
      "default": "./dist/issue/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekimuhq/anchors.git",
    "directory": "trace/trace"
  },
  "homepage": "https://github.com/dekimuhq/anchors/tree/main/trace/trace#readme",
  "bugs": "https://github.com/dekimuhq/anchors/issues",
  "keywords": [
    "agtr",
    "anchored-agent-trace-receipts",
    "trace",
    "verifier",
    "issuer",
    "ed25519"
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-anchor-pkg.mjs",
    "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@dekimuhq/anchors-disclosure": "^0.3.1",
    "@dekimuhq/anchors-envelope": "^0.26.2",
    "@dekimuhq/trace-profiles": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
