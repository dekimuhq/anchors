{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@dekimuhq/arr": ["../arr/src/index.ts"],
      "@dekimuhq/anchors-envelope": ["../../envelope/src/index.ts"],
      "@dekimuhq/anchors-envelope/tsa": ["../../envelope/src/tsa/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
