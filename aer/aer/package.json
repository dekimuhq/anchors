{
  "name": "@dekimuhq/aer",
  "version": "0.3.2",
  "description": "Anchored Evaluation Receipts (AER) v1 — verify (default) + issue (./issue) for EU AI Act conformity, transparency, and evaluation receipts.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./issue": {
      "types": "./dist/issue/index.d.ts",
      "default": "./dist/issue/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekimuhq/anchors.git",
    "directory": "aer/aer"
  },
  "homepage": "https://github.com/dekimuhq/anchors/tree/main/aer/aer#readme",
  "bugs": "https://github.com/dekimuhq/anchors/issues",
  "keywords": [
    "aer",
    "anchored-evaluation-receipts",
    "verifier",
    "issuer",
    "ed25519",
    "ai-act",
    "conformity",
    "transparency"
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-anchor-pkg.mjs",
    "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@dekimuhq/anchors-envelope": "^0.26.2",
    "@dekimuhq/aer-profiles": "^0.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
