{
  "name": "@dekimuhq/anchors-federation",
  "version": "0.1.6",
  "description": "Federated discovery for the Anchored Receipts protocol family. Fetch + verify per-issuer manifests (ar.issuer_manifest.v1), cross-issuer handshake orchestrator, and manifest caching. Pure library, zero runtime npm dependencies beyond @dekimuhq siblings.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekimuhq/anchors.git",
    "directory": "federation"
  },
  "homepage": "https://github.com/dekimuhq/anchors/tree/main/federation#readme",
  "bugs": "https://github.com/dekimuhq/anchors/issues",
  "keywords": [
    "anchored-receipts",
    "federation",
    "discovery",
    "issuer-manifest",
    "did-web",
    "ed25519",
    "interop"
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "build": "node ../scripts/build-anchor-pkg.mjs",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@dekimuhq/did-web-resolver": "^0.5.1",
    "@dekimuhq/anchors-envelope": "^0.26.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
