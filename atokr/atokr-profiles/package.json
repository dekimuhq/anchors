{
  "name": "@dekimuhq/atokr-profiles",
  "version": "0.3.3",
  "description": "Regulation profile validators for ATokR v1: tokenization.gdpr.art32, tokenization.gdpr.art4_5, tokenization.pci.dss_v4, tokenization.eudi.wallet_arf, tokenization.sector.health.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekimuhq/anchors.git",
    "directory": "atokr/atokr-profiles"
  },
  "homepage": "https://github.com/dekimuhq/anchors/tree/main/atokr/atokr-profiles#readme",
  "bugs": "https://github.com/dekimuhq/anchors/issues",
  "keywords": [
    "atokr",
    "anchored-tokenization-receipts",
    "profiles",
    "gdpr",
    "pci-dss",
    "tokenization"
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-anchor-pkg.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@dekimuhq/anchors-envelope": "^0.26.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
