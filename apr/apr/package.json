{
  "name": "@dekimuhq/apr",
  "version": "0.7.3",
  "description": "Agent Provenance Receipts (APR) v1 — verify (default) + issue (./issue) for agent action provenance anchoring.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./issue": {
      "types": "./dist/issue/index.d.ts",
      "default": "./dist/issue/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekimuhq/anchors.git",
    "directory": "apr/apr"
  },
  "homepage": "https://github.com/dekimuhq/anchors/tree/main/apr/apr#readme",
  "bugs": "https://github.com/dekimuhq/anchors/issues",
  "keywords": [
    "apr",
    "agent-provenance-receipts",
    "verifier",
    "issuer",
    "provenance",
    "ed25519",
    "merkle"
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-anchor-pkg.mjs",
    "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@dekimuhq/anchors-envelope": "^0.26.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
