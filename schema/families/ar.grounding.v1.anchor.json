{
  "$schema": "../meta-schema.v1.json",
  "id": "ar.grounding.v1",
  "acronym": "AGrR",
  "name": "Anchored Grounding Receipts",
  "claim_types": ["ar.grounding.v1"],
  "envelope": "v2",
  "sign": "ed25519",
  "canonicalize": "jcs",
  "chip": 18,
  "status_list_slot": null,
  "subject_presence": "must-be-null",
  "tsa_upgrade_path": "free",
  "tsa_mandate": { "*": "optional" },
  "body": {
    "profile": { "type": "enum", "enum_values": ["grounding.rag"], "description": "Discriminator. grounding.rag binds the cited claims of one RAG answer to source spans." },
    "answer_commit": { "type": "sha256", "description": "sha256 commit of the full answer text." },
    "sources": { "type": "array", "items": { "type": "object" }, "description": "Named source documents; each {source_id, source_commit, media_type?}." },
    "claims": { "type": "array", "items": { "type": "object" }, "description": "Answer claims; each {claim_id, claim_commit}." },
    "citations": { "type": "array", "items": { "type": "object" }, "description": "Per-citation binding+score; each {claim_id, source_id, start, end, span_commit, support, score}." },
    "coverage": { "type": "number", "description": "Fraction of claims carrying >=1 citation (derived)." },
    "grounded_count": { "type": "number", "description": "Number of claims with >=1 supported citation (derived)." },
    "scorer": { "type": "object", "description": "Scorer identity {method, name, version, threshold}." },
    "scored_at": { "type": "iso8601", "description": "RFC 3339 time the scoring ran." },
    "answer_media_type": { "type": "string", "required": false },
    "credential_id": { "type": "string", "required": false, "description": "Capability credential id the answer was produced under." },
    "caveats_consumed": { "type": "object", "required": false, "fields": { "data_scope": { "type": "string" }, "spend_step": { "type": "number" }, "spend_currency": { "type": "string", "required": false }, "capability": { "type": "string" } } }
  },
  "profiles": [ { "id": "grounding.rag", "regulation": "Dekimu Grounding — per-answer RAG citation-binding + support score" } ],
  "continuity": false,
  "status_list": false,
  "suspension": false,
  "spec_path": "https://github.com/dekimuhq/anchors-spec/tree/main/grounding",
  "packages": { "verifier": "@dekimuhq/grounding", "issuer_kit": "@dekimuhq/grounding/issue", "profiles": "@dekimuhq/grounding-profiles" }
}
